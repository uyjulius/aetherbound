; Aetherbound — Godot 4.7 port.
;
; The web build in ../src stays the reference implementation: it is playable,
; its audits pass, and the combat maths there is the spec this project is
; verified against (see ../tools/parity.mjs). Nothing here is allowed to
; disagree with it silently.
;
; Renderer settings serve the painterly 3D target: Forward+ on desktop for
; clustered lighting and detailed shadows, with a Compatibility path for the
; browser. The world is assembled from imported generated GLBs and authored
; placement data rather than runtime-created terrain or props.

config_version=5

[application]

config/name="Aetherbound"
config/description="A 3D turn-based RPG in the Final Fantasy VI tradition."
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/aetherbound-icon.png"
run/main_scene="res://scenes/title.tscn"
boot_splash/bg_color=Color(0.015, 0.02, 0.045, 1)
boot_splash/image="res://assets/ui/aetherbound-title-vista.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
; The browser has WebGL 2 and Forward+ needs Vulkan, so the web build runs
; Compatibility. Everything below this line — SDFGI, the large shadow maps, SSIL
; — is a desktop capability, and the exported build will look plainer than the
; offline renders until that gap is measured and closed deliberately.
renderer/rendering_method.web="gl_compatibility"
; The desktop renderer keeps higher-quality indirect light and shadows for native builds.
global_illumination/gi/use_half_resolution=false
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
; The browser gets a quarter of that. An 8192 shadow map is a desktop luxury: on a phone it
; is most of the frame budget, and on a CI runner with no GPU at all it was enough to make
; taking a screenshot time out.
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=1
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
scaling_3d/mode=1
; Both of the above are Forward+ features. Left set for desktop and turned off
; for the web build, because Compatibility does not merely ignore them — it warns
; on every start, and a console that always carries warnings is a console nobody
; reads when a real one appears.
anti_aliasing/quality/screen_space_aa.web=0
scaling_3d/mode.web=0
environment/ssao/quality=3
environment/ssil/quality=2
textures/default_filters/anisotropic_filtering_level=4

[physics]

3d/default_gravity=9.8
